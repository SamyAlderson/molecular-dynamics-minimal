# -*- coding: utf-8 -*-
# This should work, hopefully

import os
import re

def fix_license(file_path):
    # Hmm, this should fix the issue
    with open(file_path, 'r') as f:
        content = f.read()
    
    # Remove the file path from the content
    content = re.sub(r'File: .+', '', content)
    
    # Write the updated content back to the file
    with open(file_path, 'w') as f:
        f.write(content)

fix_license('LICENSE')